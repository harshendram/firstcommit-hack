# Gemini
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash

# Sarvam
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya

# Demo
DEMO_LANGUAGE=en-IN
# Reasoning: sarvam (default, avoids Gemini 429) | gemini | mock
LLM_PROVIDER=sarvam
SARVAM_LLM_MODEL=sarvam-105b
# Keep false so the watch gets real Sarvam TTS
USE_MOCK_SPEECH=false
USE_MOCK_AI=false

# Escalation — live Twilio phone call (SMS/WhatsApp fallback)
# Omit ESCALATION_MODE to auto-pick live when Twilio creds are present
ESCALATION_MODE=live
# voice | sms | whatsapp
ESCALATION_CHANNEL=voice
# Which hops contact a real phone (comma list, or "all"). Others animate only.
ESCALATION_CALL_ROLES=family
ESCALATION_ACK_TIMEOUT_MS=45000
ESCALATION_HOP_DELAY_MS=2000

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your purchased Twilio number, E.164 — caller ID for emergency calls
TWILIO_VOICE_FROM=
# SMS sender (often the same number)
TWILIO_SMS_FROM=
# WhatsApp requires the sandbox or an approved sender, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# Twilio TTS voice for the call
TWILIO_VOICE_NAME=Polly.Raveena

# E.164 phones for each escalation hop (use YOUR numbers for the demo)
CONTACT_NEIGHBOUR_PHONE=
CONTACT_SECURITY_PHONE=
CONTACT_FAMILY_PHONE=
CONTACT_EMS_PHONE=

# Public web origin (family-view deep link in SMS/WhatsApp)
PUBLIC_WEB_URL=http://localhost:3000
# Public https origin of this backend — enables "press 1" on calls and inbound
# SMS replies. Leave blank and set NGROK_AUTHTOKEN to have the backend open the
# tunnel itself on boot (and auto-configure the Twilio webhook).
PUBLIC_API_URL=
NGROK_AUTHTOKEN=
# Set false to stop the backend rewriting your Twilio number's SMS webhook
TWILIO_SYNC_WEBHOOKS=true

# Longitudinal care RED alerts reuse Twilio and CONTACT_FAMILY_PHONE above.
# AMBER remains dashboard-only.

# Supabase Postgres (Project Settings → Database → Connection string / URI).
# Used for username/password auth + check-in traction. Clinical demo stays in care.json.
# Example pooler: postgresql://postgres.xxx:[PASSWORD]@aws-0-…pooler.supabase.com:6543/postgres
DATABASE_URL=
# JWT secret for login tokens (set a long random string in production)
AUTH_SECRET=
# Max discharge PDF upload size in MB (Sarvam limit: 200 MB, 10 pages)
DISCHARGE_UPLOAD_MAX_MB=10

# Server
PORT=3001
HOST=0.0.0.0
