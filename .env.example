# =============================================================================
#  AWS
# =============================================================================
# Every managed service below is reached with the standard credential chain:
# an IAM role when deployed, `aws configure` / SSO locally. There are no
# third-party API keys anywhere in this stack.
AWS_REGION=us-east-1

# Point every SDK client at a local stack (LocalStack, `sam local`) during
# development. Leave blank everywhere else so the SDK resolves the real
# regional endpoint itself.
AWS_ENDPOINT_URL=
# Attempts per call, on top of the SDK's adaptive retry mode.
AWS_MAX_ATTEMPTS=4

# -----------------------------------------------------------------------------
#  Reasoning — Amazon Bedrock
# -----------------------------------------------------------------------------
# A cross-region inference profile (the "us." prefix), so Bedrock itself spreads
# load across the US regions before our own failover ever engages.
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
BEDROCK_REGION=us-east-1
# A whole turn that throttles or 5xxs in the primary region is retried here.
BEDROCK_FAILOVER_REGION=us-west-2
BEDROCK_MAX_TOKENS=512

# Reasoning backend: bedrock (default) | offline
# `offline` is the deterministic client used by CI and no-network rehearsals.
LLM_PROVIDER=bedrock
OFFLINE_AI=false

# -----------------------------------------------------------------------------
#  Voice — Amazon Transcribe (STT) + Amazon Polly (TTS)
# -----------------------------------------------------------------------------
# Transcribe streaming identifies en-IN / hi-IN per clip, so a Hinglish speaker
# never has to choose a language. Kajal covers both on one Polly voice.
POLLY_VOICE=Kajal
# generative | neural | standard — generative degrades to neural per region.
POLLY_ENGINE=generative
DEMO_LANGUAGE=en-IN
# Keep false so the watch gets real Polly audio.
OFFLINE_SPEECH=false

# -----------------------------------------------------------------------------
#  Documents — Amazon Textract + Amazon Comprehend Medical
# -----------------------------------------------------------------------------
COMPREHEND_MEDICAL_ENABLED=true
# Only needed for PDFs over Textract's 5 MB synchronous limit.
DOCUMENT_BUCKET=
# Max discharge PDF upload size in MB.
DISCHARGE_UPLOAD_MAX_MB=10

# =============================================================================
#  Escalation — Amazon SNS (SMS) + Amazon Connect (voice)
# =============================================================================
# Omit ESCALATION_MODE to auto-pick live as soon as a channel is reachable.
ESCALATION_MODE=live
# voice | sms
ESCALATION_CHANNEL=voice
# Which hops contact a real phone (comma list, or "all"). Others animate only.
ESCALATION_CALL_ROLES=family
ESCALATION_ACK_TIMEOUT_MS=45000
ESCALATION_HOP_DELAY_MS=2000

# --- SMS: Amazon SNS ---------------------------------------------------------
AWS_SMS_ENABLED=true
# Alphanumeric sender id, where the destination country supports one.
SNS_SENDER_ID=
# Every alert is mirrored here for the on-call subscribers.
OPS_TOPIC_ARN=
# Anything undeliverable lands here instead of vanishing into a log.
NOTIFICATION_DLQ_URL=

# --- Voice: Amazon Connect ---------------------------------------------------
# The contact flow plays the staged Polly clip and captures "press 1", posting
# the acknowledgement back to /api/notifications/voice/ack.
CONNECT_INSTANCE_ID=
CONNECT_CONTACT_FLOW_ID=
CONNECT_SOURCE_PHONE=
# S3 bucket the Polly clip is staged in, fetched by a 15-minute presigned URL.
CALL_AUDIO_BUCKET=

# E.164 phones for each escalation hop (use YOUR numbers for the demo).
CONTACT_NEIGHBOUR_PHONE=
CONTACT_SECURITY_PHONE=
CONTACT_FAMILY_PHONE=
CONTACT_EMS_PHONE=

# Longitudinal care RED alerts reuse the same SNS/Connect path and
# CONTACT_FAMILY_PHONE above. AMBER remains dashboard-only.

# =============================================================================
#  Data — Amazon Aurora Serverless v2 (PostgreSQL)
# =============================================================================
# Used for username/password auth + check-in traction. The clinical demo state
# stays in care.json. Either give a full URI, or name an RDS-managed secret and
# let the app read (and pick up rotations of) the credentials itself.
DATABASE_URL=
DATABASE_SECRET_ID=
# Only needed alongside DATABASE_SECRET_ID when the secret omits the endpoint.
DATABASE_HOST=
DATABASE_POOL_MAX=5
# Path to the Amazon RDS CA bundle; set it to verify the server certificate.
DATABASE_CA=

# JWT secret for login tokens. Amazon Cognito issues the tokens in the deployed
# stack; set a long random string for local development.
AUTH_SECRET=

# =============================================================================
#  Origins
# =============================================================================
# Public web origin (family-view deep link in alerts).
PUBLIC_WEB_URL=http://localhost:3000
# Public https origin of this API — the Amazon API Gateway URL when deployed.
# This is where the Amazon Connect contact flow posts "press 1". Only needed
# locally if you want that callback to reach your laptop.
PUBLIC_API_URL=

# =============================================================================
#  Server
# =============================================================================
PORT=3001
HOST=0.0.0.0
