# Ally API (FastAPI). Local: uvicorn on 8002. Deployed: the API Gateway URL from `cdk deploy` outputs.
NEXT_PUBLIC_SURAKSHA_API_URL=http://localhost:8002

# Cognito (leave empty locally to use the dev identity switcher; the API must run with ALLY_DEV_TOOLS=1)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Legacy Rakshak backend (only /patient uses these)
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_CARE_WS_URL=ws://localhost:3001/care
