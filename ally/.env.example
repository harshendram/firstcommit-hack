# ---- AWS ----
AWS_REGION=us-east-1
# Nova 2 Lite needs an inference profile: us. / eu. / jp. or global.
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
ALLY_TABLE=Ally
ALLY_STATE_MACHINE_ARN=
# Deployed: AWS Secrets Manager bundle name. Local: leave empty and use the env vars below.
ALLY_SECRET_NAME=

# ---- Cognito (local JWT verification) ----
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ---- Voice ----
ALLY_STT_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
ALLY_POLLY_VOICE=Kajal
ALLY_POLLY_ENGINE=generative

# ---- Secrets (local dev only; use SSM when deployed) ----
ALLY_VAPID_PUBLIC_KEY=
ALLY_VAPID_PRIVATE_KEY=
ALLY_DEVICE_KEY=
ALLY_HMAC_SECRET=

# ---- App ----
ALLY_PARENT_ID=amma
ALLY_PORT=8002
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Dev-only: X-Dev-Member header identity + /ally/dev/sweep. Never set when deployed.
ALLY_DEV_TOOLS=1

# ---- Timings (shorten for filming) ----
ESCALATION_CONTACT_TIMEOUT=180
INVESTIGATION_WINDOW_MIN=15
WAKE_GRACE_MIN=15
